# Normaliza finales de línea: LF en el repo para todo el texto.
* text=auto eol=lf

# Binarios (sin normalización de EOL ni diff textual)
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.gz  binary
*.npz binary

